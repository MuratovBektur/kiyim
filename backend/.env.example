DATABASE_URL="postgresql://kiyim:kiyim@localhost:5432/kiyim?schema=public"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Telegram-бот управления каталогом
TELEGRAM_BOT_TOKEN=
# phone:sellerSlug[:Название продавца],... — бутстрап первого админа.
# Если продавца с таким slug ещё нет в БД, он будет создан автоматически
# при первом входе (с указанным названием, либо самим slug, если название не задано).
# Дальше новых продавцов и админов можно добавлять прямо из бота (⚙️ Настройки → 🔐 Доступ).
ALLOWED_PHONES=

# sellerSlug|whatsapp|telegram|instagram|описание;sellerSlug2|...
# Бутстрап карточки продавца (WhatsApp/Telegram/Instagram-ссылки + описание для покупателей).
# Значение можно указать как ссылкой (https://...), так и просто @username/номером
# телефона — бот сам соберёт ссылку. Применяется только к пустым полям в БД,
# т.е. не перезатирает то, что продавец уже поменял из бота (⚙️ Настройки → 🏬 О продавце).
# Пример: SELLER_PROFILES=urbanwear|77001234567|@urbanwear_shop|@urbanwear.kz|Стритвир и повседневная одежда;stepstyle|77007654321|@stepstyle_kz||Обувь на любой сезон
SELLER_PROFILES=

# slug1,slug2,... — продавцы с этими slug получают возможность заводить
# новых продавцов из бота (⚙️ Настройки → 🔐 Доступ → 🆕 Завести нового продавца).
# Флаг только выдаётся отсюда при старте, не отзывается (снять можно вручную в БД).
BOT_ADMIN_SELLER_SLUGS=
